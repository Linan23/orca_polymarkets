# Public site settings
SITE_ADDRESS=http://localhost
FRONTEND_ORIGIN=http://localhost
FRONTEND_ADDITIONAL_ORIGINS=
VITE_API_BASE_URL=/api

# App runtime
APP_ENV=production
API_WORKERS=2
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
ALLOWED_SIGNUP_EMAIL_DOMAINS=example.com
AUTH_SECRET_KEY=change_me_to_a_long_random_secret
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# PostgreSQL
POSTGRES_DB=orca_prod
POSTGRES_USER=orca_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://orca_app:change_me@db:5432/orca_prod

# Optional ingestion settings
DUNE_API_KEY=
DUNE_QUERY_ID=2103719
POLYMARKET_ACTIVE_WINDOW_START=
POLYMARKET_ACTIVE_WINDOW_END=
KALSHI_ACTIVE_WINDOW_START=
KALSHI_ACTIVE_WINDOW_END=
