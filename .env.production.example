# Orca production/VM settings.
# Copy to /etc/orca.env or .env.production and fill on the server only.

# Public site settings.
SITE_ADDRESS=http://localhost
FRONTEND_ORIGIN=http://localhost
VITE_API_BASE_URL=/api

# App runtime.
APP_ENV=production
API_WORKERS=2
AUTH_SECRET_KEY=change_me_on_server
ALLOWED_SIGNUP_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,lafayette.edu
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# PostgreSQL.
POSTGRES_DB=orca_prod
POSTGRES_USER=orca_app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://orca_app:change_me@db:5432/orca_prod

# SMTP. Store real credentials only in the server env file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Polymarket ingest settings.
POLYMARKET_WALLETS=
POLYMARKET_ACTIVE_WINDOW_START=
POLYMARKET_ACTIVE_WINDOW_END=
LIVE_INGEST_TIMEZONE=America/New_York
LIVE_INGEST_WINDOW_START=00:00
LIVE_INGEST_WINDOW_END=00:00

# Data freshness checks.
MARKET_STALE_MINUTES=30
ORDERBOOK_STALE_MINUTES=10
TRADE_FEED_STALE_MINUTES=10
POSITIONS_STALE_MINUTES=30
ANALYTICS_STALE_MINUTES=30

# Optional integrations.
X_BEARER_TOKEN=
