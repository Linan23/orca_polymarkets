# Optional repo-level settings for local development.

APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ADDITIONAL_ORIGINS=
VITE_API_BASE_URL=

# Local auth settings. Empty ALLOWED_SIGNUP_EMAIL_DOMAINS allows any email only in development.
ALLOWED_SIGNUP_EMAIL_DOMAINS=
AUTH_SECRET_KEY=local-dev-change-me
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Optional Dune ingestion settings.
DUNE_API_KEY=
DUNE_QUERY_ID=2103719

# Optional X API settings for live @Polymarket tweet cards on the homepage.
X_BEARER_TOKEN=

# Optional active-window overrides used by scheduled jobs.
POLYMARKET_ACTIVE_WINDOW_START=
POLYMARKET_ACTIVE_WINDOW_END=
KALSHI_ACTIVE_WINDOW_START=
KALSHI_ACTIVE_WINDOW_END=
