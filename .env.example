# Orca local development settings.
# Copy to .env and fill values locally. Never commit real secrets.

APP_ENV=development
DATABASE_URL=postgresql+psycopg://app:password@localhost:5433/app_db
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8001

# Auth/session settings.
AUTH_SECRET_KEY=change_me_local_only
ALLOWED_SIGNUP_EMAIL_DOMAINS=gmail.com,hotmail.com,outlook.com,yahoo.com,lafayette.edu
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

# SMTP settings for email verification and password reset.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Polymarket ingest settings.
POLYMARKET_WALLETS=
POLYMARKET_ACTIVE_WINDOW_START=
POLYMARKET_ACTIVE_WINDOW_END=
LIVE_INGEST_TIMEZONE=America/New_York
LIVE_INGEST_WINDOW_START=00:00
LIVE_INGEST_WINDOW_END=00:00

# Data freshness checks.
MARKET_STALE_MINUTES=30
ORDERBOOK_STALE_MINUTES=10
TRADE_FEED_STALE_MINUTES=10
POSITIONS_STALE_MINUTES=30
ANALYTICS_STALE_MINUTES=30

# Optional integrations.
X_BEARER_TOKEN=
